{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::${stage_bucket_name}/metadata/*",
        "arn:aws:s3:::${stage_bucket_name}"
      ],
      "Effect": "Allow",
      "Sid": "ReadOnlyObjects"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:*multipart*"
      ],
      "Resource": [
        "arn:aws:s3:::${stage_bucket_name}/cutouts/*"
      ],
      "Effect": "Allow",
      "Sid": "FullAccessCutoutsPrefix"
    }
  ]
}